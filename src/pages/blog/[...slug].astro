---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getReadingTime } from '@/lib/reading-time';

export async function getStaticPaths() {
  const blogPosts = await getCollection('blog');
  const sortedPosts = blogPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  return sortedPosts.map((post, index) => {
    // Related posts
    const relatedPosts = sortedPosts
      .filter((other) => other.id !== post.id)
      .map((other) => ({
        post: other,
        shared: (other.data.tags || []).filter((tag) => (post.data.tags || []).includes(tag)).length,
      }))
      .filter(({ shared }) => shared > 0)
      .sort((a, b) => b.shared - a.shared)
      .slice(0, 3)
      .map(({ post }) => post);

    return {
      params: { slug: post.id },
      props: {
        post,
        prevPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
        nextPost: index > 0 ? sortedPosts[index - 1] : null,
        relatedPosts,
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'blog'>;
  prevPost: CollectionEntry<'blog'> | null;
  nextPost: CollectionEntry<'blog'> | null;
  relatedPosts: CollectionEntry<'blog'>[];
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content } = await render(post);
const readingTime = getReadingTime(post.body ?? '');

// Format date helper
function formatDate(date: Date) {
  return new Date(date).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

// 👇 목차(사이드바)용 데이터 불러오기 (중복 에러 방지를 위해 변수명 tocPosts로 변경)
const tocPosts = await getCollection('blog');
const sortedTocPosts = tocPosts.sort((a, b) => {
  const volA = a.data.volume || 99;
  const volB = b.data.volume || 99;
  if (volA !== volB) return volA - volB;
  
  const chapA = a.data.chapter || 99;
  const chapB = b.data.chapter || 99;
  return chapA - chapB;
});

const postsByVolume = sortedTocPosts.reduce((acc, p) => {
  const vol = p.data.volume || 99;
  if (!acc[vol]) acc[vol] = [];
  acc[vol].push(p);
  return acc;
}, {});
---


<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image?.src}
  type="article"
  publishedTime={post.data.pubDate}
  author={post.data.author}
>
  <!-- 화면을 좌/우로 나누는 거대한 틀 -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 flex flex-col lg:flex-row gap-8 lg:gap-16 relative">
    
    <!-- 👈 [왼쪽] 구글 문서 스타일 사이드바 -->
    <aside class="w-full lg:w-56 flex-shrink-0 pt-12">
      <div class="sticky top-24">
        <div class="space-y-6 text-sm">
          
          {Object.entries(postsByVolume).map(([volString, posts]) => {
            const isCurrentVolume = posts.some(p => p.id === post.id);
            const volumeTitle = posts[0]?.data.description || `${volString}권`;
            
            return (
              <details class="group" open={isCurrentVolume}>
                <summary class="font-bold text-foreground cursor-pointer list-none select-none text-base mb-3 hover:text-primary transition-colors">
                  {volumeTitle}
                </summary>
                
                <ul class="space-y-3 text-muted-foreground border-l-[1.5px] border-border/60 ml-1 pl-4">
                  {posts.map((p) => {
                    const isCurrent = p.id === post.id;
                    return (
                      <li class={`${isCurrent ? 'text-primary font-bold' : 'hover:text-foreground transition-colors'}`}>
                        <a href={`/blog/${p.id}`} class="block py-0.5">
                          {p.data.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            );
          })}

        </div>
      </div>
    </aside>

    <!-- 👉 [오른쪽] 소설 본문 영역 -->
    <article class="flex-1 min-w-0 pb-12">
      <div class="container max-w-3xl mx-auto pt-12 mb-8">
        <a href="/blog" class="inline-flex items-center text-sm text-muted-foreground hover:text-primary transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2">
            <path d="m15 18-6-6 6-6"></path>
          </svg>
          목록으로
        </a>
      </div>

      <header class="mb-12">
        <div class="container max-w-3xl mx-auto space-y-4">
          <h1 class="text-5xl font-bold tracking-tight">{post.data.title}</h1>
          <p class="text-xl text-muted-foreground">{post.data.description}</p>
          <div class="flex items-center gap-4 text-sm text-muted-foreground pt-2">
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            <span>•</span>
            <span>{post.data.author || '42 (Mari)'}</span>
            <span>•</span>
            <span>{readingTime.text}</span>
          </div>
          {
            post.data.tags?.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-2">
                {post.data.tags.map((tag) => (
                  <a href={`/tags/${tag}`} class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-primary/10 text-primary hover:bg-primary/20 transition-colors">
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div class="container max-w-3xl mx-auto px-6 sm:px-8">
        <div class="prose prose-neutral dark:prose-invert max-w-none novel-text">
          <Content />
        </div>

        {
          relatedPosts?.length > 0 && (
            <aside class="mt-16 pt-8 border-t" aria-labelledby="related-heading">
              <h2 id="related-heading" class="text-xl font-bold tracking-tight mb-6">관련 에피소드</h2>
              <ul class="grid gap-4 sm:grid-cols-3">
                {relatedPosts.map((related) => (
                  <li>
                    <a href={`/blog/${related.id}`} class="group block h-full rounded-lg border border-border bg-card p-4 transition-colors hover:bg-accent/50">
                      <span class="mt-2 block text-sm font-medium leading-snug group-hover:text-primary transition-colors">
                        {related.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )
        }

        <footer class="mt-12 pt-8 border-t">
          <nav class="flex items-center justify-between gap-8">
            {
              prevPost ? (
                <a href={`/blog/${prevPost.id}`} class="group flex-1 text-left">
                  <div class="text-xs text-muted-foreground mb-1">이전 화</div>
                  <div class="text-sm font-medium group-hover:text-primary transition-colors">{prevPost.data.title}</div>
                </a>
              ) : <div class="flex-1" />
            }
            {
              nextPost ? (
                <a href={`/blog/${nextPost.id}`} class="group flex-1 text-right">
                  <div class="text-xs text-muted-foreground mb-1">다음 화</div>
                  <div class="text-sm font-medium group-hover:text-primary transition-colors">{nextPost.data.title}</div>
                </a>
              ) : <div class="flex-1" />
            }
          </nav>
        </footer>
      </div>
    </article>
  </div> 

  <!-- 진행바, 리모컨 팝업, 엽서 기능 유지 -->
  <div class="fixed top-0 left-0 w-full h-1 z-50 bg-transparent pointer-events-none">
    <div id="progress-bar" class="h-full bg-primary w-0 transition-all duration-150"></div>
  </div>

  <div class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3 pointer-events-auto">
    <div id="viewer-menu" class="hidden flex-col bg-card/95 backdrop-blur-md border border-border rounded-xl shadow-2xl p-4 w-[280px] gap-4 origin-bottom-right transition-all">
      <div class="flex items-center gap-4">
        <span class="text-sm font-medium text-muted-foreground w-8">글꼴</span>
        <div class="flex flex-1 bg-muted rounded-lg p-1 text-sm font-medium">
          <button id="btn-font-serif" class="flex-1 py-1.5 rounded-md bg-background shadow-sm transition-all">명조</button>
          <button id="btn-font-sans" class="flex-1 py-1.5 rounded-md hover:bg-background/50 transition-all">고딕</button>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-sm font-medium text-muted-foreground w-8">크기</span>
        <div class="flex flex-1 items-center bg-muted rounded-lg p-1 text-sm font-medium">
          <button id="btn-text-minus" class="flex-1 py-1.5 hover:bg-background/50 rounded-md transition-all">-</button>
          <span id="text-size-display" class="w-14 text-center">100%</span>
          <button id="btn-text-plus" class="flex-1 py-1.5 hover:bg-background/50 rounded-md transition-all">+</button>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-sm font-medium text-muted-foreground w-8">간격</span>
        <div class="flex flex-1 bg-muted rounded-lg p-1 text-sm font-medium">
          <button id="btn-space-narrow" class="flex-1 py-1.5 rounded-md hover:bg-background/50 transition-all">좁게</button>
          <button id="btn-space-normal" class="flex-1 py-1.5 rounded-md bg-background shadow-sm transition-all">보통</button>
          <button id="btn-space-wide" class="flex-1 py-1.5 rounded-md hover:bg-background/50 transition-all">넓게</button>
        </div>
      </div>
    </div>
    <button id="btn-remote-toggle" class="p-3 bg-card/80 backdrop-blur border border-border rounded-full shadow-lg opacity-70 hover:opacity-100 hover:border-primary/50 transition-all group">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-foreground group-hover:text-primary transition-colors">
        <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
        <circle cx="12" cy="12" r="3"></circle>
      </svg>
    </button>
  </div>

  <button id="quote-tooltip" class="hidden absolute z-50 px-4 py-2 bg-primary text-primary-foreground text-sm font-medium rounded-full shadow-xl pointer-events-auto transition-opacity hover:scale-105">
    📸 이미지로 공유
  </button>
  
  <div id="export-container" class="fixed top-0 left-[-9999px] z-[-1]">
    <div id="export-card" class="w-[1080px] h-[1350px] bg-[#0b0710] flex flex-col justify-between p-24 relative overflow-hidden">
      <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.2) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.2) 1px, transparent 1px); background-size: 60px 60px;"></div>
      <div class="flex-1 flex items-center justify-center z-10">
        <p id="export-text" class="text-[#f1f1f1] text-5xl leading-[1.8] break-keep text-center" style="font-family: 'MaruBuri-Regular', serif;">
          텍스트가 들어가는 자리
        </p>
      </div>
      <div class="flex justify-between items-end border-t border-white/20 pt-10 z-10" style="font-family: 'Pretendard', sans-serif;">
        <div class="text-white/80">
          <div id="export-title" class="text-3xl font-bold mb-3">소설 제목</div>
          <div class="text-2xl text-white/60 mb-5">Vol. {post.data.volume || 1}</div>
          <div class="text-xl tracking-wider text-white/50">By 42 (Mari)</div>
        </div>
        <div class="flex items-center gap-6">
          <div class="text-right">
            <span class="block text-white/40 text-lg mb-1">SCAN TO READ</span>
            <span class="block text-white/70 font-medium text-xl">your-domain.com</span>
          </div>
          <canvas id="qr-canvas" class="w-28 h-28 bg-white p-2 rounded-lg"></canvas>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js"></script>

<script>
  document.addEventListener('astro:page-load', () => {
    // 엽서 제목 가져오기
    const pageTitle = document.title.split('|')[0] || '단행본';
    const exportTitleEl = document.getElementById('export-title');
    if (exportTitleEl) exportTitleEl.innerText = pageTitle;

    // 1. 스크롤 진행바
    const progressBar = document.getElementById('progress-bar');
    window.addEventListener('scroll', () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      if (height > 0 && progressBar) progressBar.style.width = (winScroll / height) * 100 + '%';
    });

    // 2. 뷰어 리모컨 기능
    const btnToggle = document.getElementById('btn-remote-toggle');
    const menu = document.getElementById('viewer-menu');
    if(btnToggle) {
      let savedSize = parseFloat(localStorage.getItem('vSize')) || 1.05;
      let savedSpacing = parseFloat(localStorage.getItem('vSpace')) || 1.85;
      let savedFont = localStorage.getItem('vFont') || "'MaruBuri-Regular', serif";

      const applySize = (size) => {
        savedSize = size;
        document.documentElement.style.setProperty('--viewer-size', `${size}rem`);
        document.getElementById('text-size-display').innerText = `${Math.round((size / 1.05) * 100)}%`;
        localStorage.setItem('vSize', size);
      };

      const applySpacing = (space) => {
        savedSpacing = space;
        document.documentElement.style.setProperty('--viewer-spacing', space);
        localStorage.setItem('vSpace', space);
        
        ['narrow', 'normal', 'wide'].forEach(type => {
          document.getElementById(`btn-space-${type}`).classList.remove('bg-background', 'shadow-sm');
        });
        if(space === 1.6) document.getElementById('btn-space-narrow').classList.add('bg-background', 'shadow-sm');
        else if(space === 1.85) document.getElementById('btn-space-normal').classList.add('bg-background', 'shadow-sm');
        else document.getElementById('btn-space-wide').classList.add('bg-background', 'shadow-sm');
      };

      const applyFont = (font) => {
        savedFont = font;
        document.documentElement.style.setProperty('--viewer-font', font);
        localStorage.setItem('vFont', font);
        
        if(font.includes('MaruBuri')) {
          document.getElementById('btn-font-serif').classList.add('bg-background', 'shadow-sm');
          document.getElementById('btn-font-sans').classList.remove('bg-background', 'shadow-sm');
        } else {
          document.getElementById('btn-font-sans').classList.add('bg-background', 'shadow-sm');
          document.getElementById('btn-font-serif').classList.remove('bg-background', 'shadow-sm');
        }
      };

      applySize(savedSize);
      applySpacing(savedSpacing);
      applyFont(savedFont);

      btnToggle.addEventListener('click', () => {
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
      });
      
      document.getElementById('btn-text-plus').addEventListener('click', () => {
        if (savedSize < 1.6) applySize(savedSize + 0.1);
      });
      document.getElementById('btn-text-minus').addEventListener('click', () => {
        if (savedSize > 0.8) applySize(savedSize - 0.1);
      });
      document.getElementById('btn-space-narrow').addEventListener('click', () => applySpacing(1.6));
      document.getElementById('btn-space-normal').addEventListener('click', () => applySpacing(1.85));
      document.getElementById('btn-space-wide').addEventListener('click', () => applySpacing(2.2));
      document.getElementById('btn-font-serif').addEventListener('click', () => applyFont("'MaruBuri-Regular', serif"));
      document.getElementById('btn-font-sans').addEventListener('click', () => applyFont("'Pretendard', sans-serif"));
    }

    // 3. 드래그 발췌 기능
    const tooltip = document.getElementById('quote-tooltip');
    let selectedText = '';

    document.addEventListener('selectionchange', () => {
      const selection = window.getSelection();
      selectedText = selection.toString().trim();
      
      if (selectedText.length > 0) {
        const range = selection.getRangeAt(0);
        const rect = range.getBoundingClientRect();
        tooltip.style.top = `${rect.bottom + window.scrollY + 15}px`;
        tooltip.style.left = `${rect.left + (rect.width / 2) - 60}px`; 
        tooltip.classList.remove('hidden');
      } else {
        tooltip.classList.add('hidden');
      }
    });

    tooltip.addEventListener('click', async () => {
      tooltip.innerText = '⏳ 생성 중...';
      
      let displayText = selectedText;
      if (displayText.length > 150) displayText = displayText.substring(0, 150) + '...';
      document.getElementById('export-text').innerText = displayText;

      new QRious({
        element: document.getElementById('qr-canvas'),
        value: window.location.href, // 👈 QR을 찍으면 현재 읽고 있는 글로 바로 이동합니다!
        size: 200,
        background: '#ffffff',
        foreground: '#000000'
      });

      const card = document.getElementById('export-card');
      const canvas = await html2canvas(card, { scale: 1.5, useCORS: true });
      
      const link = document.createElement('a');
      link.download = 'quote_export.png';
      link.href = canvas.toDataURL('image/png');
      link.click();

      tooltip.innerText = '📸 이미지로 공유';
      window.getSelection().removeAllRanges();
      tooltip.classList.add('hidden');
    });
  });
</script>
