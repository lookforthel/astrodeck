---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// 1. 역순 정렬을 정방향(오름차순)으로 완벽하게 뒤집기
const sortedPosts = allPosts.sort((a, b) => {
  const volA = a.data.volume || 99;
  const volB = b.data.volume || 99;
  if (volA !== volB) return volA - volB;
  
  const chapA = a.data.chapter || 99;
  const chapB = b.data.chapter || 99;
  return chapA - chapB;
});

// 2. 권(Volume) 단위로 데이터 묶기
const postsByVolume = sortedPosts.reduce((acc, p) => {
  const vol = p.data.volume || 99;
  if (!acc[vol]) acc[vol] = [];
  acc[vol].push(p);
  return acc;
}, {});
---

<BaseLayout title="Merge Conflict" description="SF GL">
  
  <!-- 🛑 인증 팝업 (로컬 스토리지 연동) -->
  <div id="age-gate-modal" class="fixed inset-0 z-[100] bg-background/95 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="bg-card border border-border rounded-2xl max-w-sm w-full p-8 shadow-2xl flex flex-col items-center text-center gap-6 relative">
      <div class="text-primary mb-2 opacity-80">
        <!-- 자물쇠 아이콘 -->
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-foreground">19 ↑?</h2>
      <div class="flex gap-3 w-full mt-2">
        <button id="btn-age-no" class="flex-1 py-3 rounded-xl border border-border bg-muted/50 text-muted-foreground hover:text-foreground font-medium transition-colors">
          나가기
        </button>
        <button id="btn-age-yes" class="flex-1 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:opacity-90 transition-opacity">
          열람 승인
        </button>
      </div>
    </div>
  </div>

  <!-- 📖 단행본 목차 컨테이너 -->
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-16">
    
    <!-- 상단 헤더 -->
    <header class="mb-16 text-center">
      <h1 class="text-4xl font-bold tracking-tight mb-4">Archive</h1>
      <p class="text-muted-foreground">뭐라고쓸까</p>
    </header>

    <!-- 권별 아코디언 + 바둑판 챕터 레이아웃 -->
    <div class="space-y-8 pb-24">
      {Object.entries(postsByVolume).map(([volString, posts], index) => {
        const volumeTitle = `Volume ${volString}`;
        
        return (
          <section class="border border-border/50 bg-card/30 rounded-2xl overflow-hidden shadow-sm">
            {/* index === 0 이면 첫 번째 권(Volume 1)은 기본으로 펼쳐놓습니다. */}
            <details class="group" open={index === 0}>
              <summary class="flex items-center justify-between p-6 cursor-pointer bg-card hover:bg-muted/30 transition-colors select-none">
                <h2 class="text-2xl font-bold tracking-wide">{volumeTitle}</h2>
                <span class="text-muted-foreground transition-transform duration-300 group-open:rotate-180">
                  <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              
              <div class="p-6 pt-2 border-t border-border/50">
                <!-- PC에서는 3칸, 태블릿은 2칸, 모바일은 1칸으로 자동 배치되는 그리드 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                  {posts.map((post) => (
                    <a href={`/blog/${post.id}`} class="flex flex-col p-4 rounded-xl border border-border/50 bg-background hover:border-primary/50 hover:bg-card transition-all group shadow-sm">
                      <span class="text-xs text-primary font-medium mb-1">
                        Chapter {post.data.chapter}
                      </span>
                      <span class="text-base font-bold text-foreground group-hover:text-primary transition-colors line-clamp-1">
                        {post.data.title}
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            </details>
          </section>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const ageModal = document.getElementById('age-gate-modal');
    const btnYes = document.getElementById('btn-age-yes');
    const btnNo = document.getElementById('btn-age-no');

    if (!ageModal) return;

    // 브라우저 캐시(로컬 스토리지)에 인증 기록이 있는지 확인
    const isAdult = localStorage.getItem('isAdultConfirmed');
    
    if (isAdult === 'true') {
      // 이미 승인한 유저면 팝업을 아예 안 보여줌
      ageModal.style.display = 'none';
      document.body.style.overflow = 'auto';
    } else {
      // 처음 온 유저면 팝업을 띄우고 배경 스크롤을 막음
      document.body.style.overflow = 'hidden';
    }

    // [열람 승인] 버튼 클릭
    btnYes?.addEventListener('click', () => {
      localStorage.setItem('isAdultConfirmed', 'true');
      ageModal.style.opacity = '0'; // 부드럽게 사라지는 효과
      setTimeout(() => {
        ageModal.style.display = 'none';
        document.body.style.overflow = 'auto'; // 스크롤 잠금 해제
      }, 300); 
    });

    // [나가기] 버튼 클릭
    btnNo?.addEventListener('click', () => {
      window.location.href = '/'; // 사이트 메인 홈으로 돌려보냄
    });
  });
</script>
