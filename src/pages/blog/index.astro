---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// 1. 역순 정렬을 정방향(오름차순)으로 완벽하게 뒤집기
const sortedPosts = allPosts.sort((a, b) => {
  const volA = a.data.volume || 99;
  const volB = b.data.volume || 99;
  if (volA !== volB) return volA - volB;
  
  const chapA = a.data.chapter || 99;
  const chapB = b.data.chapter || 99;
  return chapA - chapB;
});

// 2. 권(Volume) 단위로 데이터 묶기
const postsByVolume = sortedPosts.reduce((acc, p) => {
  const vol = p.data.volume || 99;
  if (!acc[vol]) acc[vol] = [];
  acc[vol].push(p);
  return acc;
}, {});
---

<BaseLayout title="단행본 목록" description="하드 SF GL 웹소설">
  
  <!-- 🛑 성인 인증 팝업 (로컬 스토리지 연동) -->
  <div id="age-gate-modal" class="fixed inset-0 z-[100] bg-background/95 backdrop-blur-md flex items-center justify-center p-4 transition-opacity duration-300">
    <div class="bg-card border border-border rounded-2xl max-w-sm w-full p-8 shadow-2xl flex flex-col items-center text-center gap-6 relative">
      <div class="text-primary mb-2 opacity-80">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-foreground">Warning</h2>
      <p class="text-muted-foreground text-sm break-keep leading-relaxed">
        19↑ ?<br/><br/>
      </p>
      <div class="flex gap-3 w-full mt-2">
        <button id="btn-age-no" class="flex-1 py-3 rounded-xl border border-border bg-muted/50 text-muted-foreground hover:text-foreground font-medium transition-colors">
          No
        </button>
        <button id="btn-age-yes" class="flex-1 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:opacity-90 transition-opacity">
          Yes
        </button>
      </div>
    </div>
  </div>

  <!-- 📖 단행본 텍스트형 목차 컨테이너 -->
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    
    <header class="mb-16 text-center">
      <h1 class="text-4xl font-bold tracking-tight mb-4">Archive</h1>
      <p class="text-muted-foreground">SF GL</p>
    </header>

    <div class="space-y-12 pb-24">
      {Object.entries(postsByVolume).map(([volString, posts], index) => {
        const volumeTitle = `Volume ${volString}`;
        
        return (
          <details class="group" open={index === 0}>
            {/* 권별 타이틀: 굵은 선으로 미니멀하게 영역만 분리 */}
            <summary class="flex items-center justify-between pb-4 border-b-2 border-border/80 cursor-pointer select-none">
              <h2 class="text-2xl font-bold tracking-wide text-foreground group-hover:text-primary transition-colors">{volumeTitle}</h2>
              <span class="text-muted-foreground transition-transform duration-300 group-open:rotate-180">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
            </summary>
            
            {/* 챕터 리스트: 박스를 없애고 밑줄 텍스트 형식으로 변경 */}
            <div class="pt-2">
              <ul class="flex flex-col">
                {posts.map((post) => (
                  <li>
                    {/* py-4 px-2로 보이지 않는 터치 영역을 위아래로 넓게 확보! */}
                    <a href={`/blog/${post.id}`} class="group flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-6 py-4 px-2 border-b border-border/40 hover:bg-muted/30 transition-colors w-full rounded-md">
                      <span class="text-sm font-mono text-primary/80 shrink-0">
                        Ch. {post.data.chapter?.toString().padStart(2, '0') || '00'}
                      </span>
                      <span class="text-lg font-medium text-foreground group-hover:text-primary transition-colors line-clamp-1">
                        {post.data.title}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </details>
        );
      })}
    </div>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const ageModal = document.getElementById('age-gate-modal');
    const btnYes = document.getElementById('btn-age-yes');
    const btnNo = document.getElementById('btn-age-no');

    if (!ageModal) return;

    const isAdult = localStorage.getItem('isAdultConfirmed');
    
    if (isAdult === 'true') {
      ageModal.style.display = 'none';
      document.body.style.overflow = 'auto';
    } else {
      document.body.style.overflow = 'hidden';
    }

    btnYes?.addEventListener('click', () => {
      localStorage.setItem('isAdultConfirmed', 'true');
      ageModal.style.opacity = '0';
      setTimeout(() => {
        ageModal.style.display = 'none';
        document.body.style.overflow = 'auto';
      }, 300); 
    });

    btnNo?.addEventListener('click', () => {
      window.location.href = '/'; 
    });
  });
</script>
