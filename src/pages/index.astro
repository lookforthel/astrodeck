---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Merge Conflict" description="개인 아카이브 및 소설 연재처">
  
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 md:py-20 flex items-center justify-center min-h-[80vh]">
    
    <!-- 🔲 메인 HUD 박스 -->
    <div class="relative w-full bg-card/5 border border-primary/20 rounded-xl p-6 md:p-12 font-mono shadow-2xl backdrop-blur-sm overflow-hidden group">
      
      <!-- ✨ 구석 애니메이션 (조준경 마커) -->
      <div class="absolute top-4 left-4 w-6 h-6 border-t-2 border-l-2 border-primary/50 opacity-70 group-hover:opacity-100 transition-opacity"></div>
      <div class="absolute top-4 right-4 w-6 h-6 border-t-2 border-r-2 border-primary/50 opacity-70 group-hover:opacity-100 transition-opacity"></div>
      <div class="absolute bottom-4 left-4 w-6 h-6 border-b-2 border-l-2 border-primary/50 opacity-70 group-hover:opacity-100 transition-opacity"></div>
      <div class="absolute bottom-4 right-4 w-6 h-6 border-b-2 border-r-2 border-primary/50 opacity-70 group-hover:opacity-100 transition-opacity"></div>

      <!-- 📱 내부 콘텐츠 그리드 -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 relative z-10">
        
        <!-- ⬅️ 좌측 패널 (실시간 생체/호르몬 데이터 & 심전도) -->
        <div class="col-span-1 flex flex-col gap-6 order-2 lg:order-1">
          
          <div class="p-4 border border-border/30 bg-background/40 rounded-lg overflow-hidden relative group">
            <h3 class="text-xs text-muted-foreground tracking-widest mb-3 border-b border-border/20 pb-2">[ BIO_SYNC : ACTIVE ]</h3>
            
            <!-- 📈 SVG 심전도 애니메이션 -->
            <div class="h-16 w-full mb-4 relative overflow-hidden flex items-center opacity-80 border-b border-border/10">
              <svg class="absolute w-[200%] h-full ecg-animate text-[#329852]" viewBox="0 0 200 100" preserveAspectRatio="none">
                <path d="M0,50 L20,50 L25,30 L35,90 L45,10 L55,70 L60,50 L100,50 L120,50 L125,30 L135,90 L145,10 L155,70 L160,50 L200,50" 
                      fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>

            <!-- 📊 실시간 변동 데이터 리스트 -->
            <ul class="text-[13px] space-y-2 text-foreground/80 font-mono">
              <li class="flex justify-between items-center">
                <span class="opacity-70">TARGET:</span> 
                <span>Human_Neva</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="opacity-70">HEART_RATE:</span> 
                <span class="text-[#329852] font-bold"><span id="bpm-value">58</span> bpm</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="opacity-70">O2_CONSUMPTION:</span> 
                <span class="text-[#329852]"><span id="o2-value">45.2</span> L/h</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="opacity-70">CORE_TEMP:</span> 
                <span class="text-orange-400/90"><span id="temp-value">37.2</span> °C</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="opacity-70">CORTISOL_LVL:</span> 
                <span class="text-blue-400/90"><span id="cortisol-value">9.4</span> ㎍/dL</span>
              </li>
              <li class="flex justify-between items-center">
                <span class="opacity-70">OXYTOCIN_LVL:</span> 
                <span class="text-pink-400/90"><span id="oxy-value">42</span> % <span class="text-[10px] animate-pulse">(High)</span></span>
              </li>
              <li class="flex justify-between items-center mt-2 pt-2 border-t border-border/10">
                <span class="opacity-70">PROSTHETIC_SYNC:</span> 
                <span class="text-[#329852]">98.4%</span>
              </li>
            </ul>
          </div>
          
          <!-- 백그라운드 태스크 블록 -->
          <div class="p-4 border border-border/30 bg-background/40 rounded-lg">
            <h3 class="text-xs text-muted-foreground tracking-widest mb-3 border-b border-border/20 pb-2">[ BACKGROUND_TASKS ]</h3>
            <ul class="text-[11px] leading-relaxed space-y-3 text-muted-foreground font-mono">
              <li class="line-through opacity-40">[✓] 제3 화물칸 대기 순환 필터 미세먼지 정화</li>
              <li class="text-foreground/90">[▶] Human_Neva 샤워 모니터링 (예상: 운동 루틴 종료 후, 4시간 뒤)</li>
              <li>[✓] Human_Cathode 온수 사용량 50% 제한 (사유: 에너지 절약)</li>
              <li>[▶] 주 엔진 냉각수 파이프라인 열화상 스캔 및 위상 보정</li>
              <li class="text-foreground/90">[▶] Human_Neva 수분 손실에 따른 맞춤형 전해질 음료 배합</li>
              <li>[✓] Human_Cathode 생활구역B 출입 권한 박탈 (사유: 오염 및 소음 방지)</li>
              <li class="text-orange-400/80">[■] Human_Neva 골반 및 허벅지 근육통 방지 온열 마사지 모듈 (대기)</li>
            </ul>
          </div>

        </div>

        <!-- 🎯 중앙 패널 (메인 타이틀 & 환영 인사) -->
        <div class="col-span-1 lg:col-span-2 flex flex-col justify-center order-1 lg:order-2">
          
          <div class="mb-8">
            <p class="text-primary/80 text-sm tracking-widest mb-2">ACCESS GRANTED</p>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-4">MERGE CONFLICT</h1>
            <p class="text-muted-foreground leading-relaxed break-keep max-w-xl">
              이곳은 우주 외곽을 떠도는 퇴역 군함 코모란트의 아카이브입니다.<br/>
              지각이 있는 인공 존재(ACE)와 강화 인간의 병합 데이터를 기록하고 있습니다.
            </p>
          </div>

          <!-- 빠른 이동 버튼 영역 -->
          <div class="flex flex-col sm:flex-row gap-4 mt-4">
            <a href="/blog" class="px-6 py-3 bg-primary/10 border border-primary/30 text-primary hover:bg-primary/20 hover:border-primary/50 transition-all rounded-md text-center text-sm tracking-widest font-bold">
              [ ACCESS_NOVELS ]
            </a>
            <a href="/gallery" class="px-6 py-3 bg-card border border-border/50 hover:border-foreground/50 transition-all rounded-md text-center text-sm tracking-widest text-muted-foreground hover:text-foreground">
              [ VIEW_GALLERY ]
            </a>
          </div>

          <!-- 사이트 이용 안내 -->
          <div class="mt-12 pt-6 border-t border-border/20 text-xs text-muted-foreground space-y-2">
            <p>> <strong>Novels:</strong> 오리지널 SF GL소설 연재 공간입니다. (※ 청소년 이용불가)</p>
            <p>> <strong>Gallery:</strong> 커미션을 포함한 시각 데이터가 올라옵니다./p>
            <p class="opacity-60 pt-2">© 2026 둑중개. All Data Encrypted. Unauthorized access will be monitored.</p>
          </div>

        </div>

      </div>
    </div>
  </div>

</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const bpmEl = document.getElementById('bpm-value');
    const o2El = document.getElementById('o2-value');
    const tempEl = document.getElementById('temp-value');
    const cortisolEl = document.getElementById('cortisol-value');
    const oxyEl = document.getElementById('oxy-value');
    const pupilEl = document.getElementById('pupil-value');

    if(bpmEl && o2El && tempEl && cortisolEl && oxyEl && pupilEl) {
      setInterval(() => {
        // 강화 심장: 55 ~ 65 사이의 묵직한 박동
        bpmEl.innerText = Math.floor(Math.random() * (65 - 55 + 1)) + 55;
        // 산소 소모량: 45.0 ~ 48.0 L/h
        o2El.innerText = (Math.random() * (48.0 - 45.0) + 45.0).toFixed(1);
        // 체온: 37.0 ~ 37.5 사이
        tempEl.innerText = (Math.random() * (37.5 - 37.0) + 37.0).toFixed(1);
        // 코르티솔: 8.0 ~ 12.0 (스트레스 수치 낮음 = 안정된 상태)
        cortisolEl.innerText = (Math.random() * (12.0 - 8.0) + 8.0).toFixed(1);
        // 옥시토신: 40 ~ 65% (애착 호르몬 활성화 상태)
        oxyEl.innerText = Math.floor(Math.random() * (65 - 40 + 1)) + 40;
        // 동공 확장: 10 ~ 15
        pupilEl.innerText = Math.floor(Math.random() * (15 - 10 + 1)) + 10;
      }, 2000);
    }
  });
</script>

<style>
  .ecg-animate {
    animation: ecgSlide 1.5s linear infinite;
  }
  @keyframes ecgSlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
