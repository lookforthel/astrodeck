---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Merge Conflict" description="개인 아카이브 및 소설 연재처">
  
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-12 md:py-20 flex items-center justify-center min-h-[80vh]">
    
    <!-- 🔲 메인 HUD 컨테이너 -->
    <div class="w-full font-mono text-foreground/80">
      
      <!-- 📱 5분할 대시보드 그리드 (모바일: order로 정렬 / 데스크톱: 3열 2행 완벽 정렬) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 relative z-10">
        
        <!-- [4] BIO_SYNC (좌측 상단) -->
        <div class="order-4 lg:order-none lg:col-start-1 lg:row-start-1 flex flex-col p-5 border border-border/20 bg-card/30 rounded-xl shadow-sm">
          <h3 class="text-xs font-bold text-[#8b5cf6] tracking-widest border-b border-[#8b5cf6]/30 pb-2 mb-4">
            [ BIO_SYNC : ACTIVE ]
          </h3>
          
          <!-- 📈 SVG 심전도 애니메이션 -->
          <div class="h-12 w-full mb-5 relative overflow-hidden flex items-center opacity-80 border-b border-border/10">
            <svg class="absolute w-[200%] h-full ecg-animate text-[#8b5cf6]" viewBox="0 0 200 100" preserveAspectRatio="none">
              <path d="M0,50 L20,50 L25,30 L35,90 L45,10 L55,70 L60,50 L100,50 L120,50 L125,30 L135,90 L145,10 L155,70 L160,50 L200,50" 
                    fill="none" stroke="currentColor" stroke-width="1.5" vector-effect="non-scaling-stroke" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>

          <!-- 📊 실시간 생체 데이터 리스트 -->
          <ul class="text-xs space-y-3 opacity-90 flex-grow">
            <li class="flex justify-between items-center">
              <span class="opacity-50">TARGET:</span> 
              <span class="text-foreground">Human_Neva</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="opacity-50">HEART_RATE:</span> 
              <span class="text-[#8b5cf6] font-bold"><span id="bpm-value">58</span> bpm</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="opacity-50">O2_CONSUMPTION:</span> 
              <span class="text-[#8b5cf6]"><span id="o2-value">45.2</span> L/h</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="opacity-50">CORE_TEMP:</span> 
              <span class="text-foreground"><span id="temp-value">37.2</span> °C</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="opacity-50">CORTISOL_LVL:</span> 
              <span class="text-foreground"><span id="cortisol-value">9.4</span> ㎍/dL</span>
            </li>
            <li class="flex justify-between items-center">
              <span class="opacity-50">OXYTOCIN_LVL:</span> 
              <span class="text-[#8b5cf6]"><span id="oxy-value">42</span> % <span class="text-[10px] animate-pulse opacity-70">(High)</span></span>
            </li>
          </ul>
          <div class="mt-3 pt-3 border-t border-border/10 text-xs flex justify-between items-center">
            <span class="opacity-50">PROSTHETIC_SYNC:</span> 
            <span class="text-[#8b5cf6]">98.4%</span>
          </div>
        </div>

        <!-- [1] 메인 타이틀 & 환영 인사 (중앙+우측 상단, 가로 2칸 차지) -->
        <div class="order-1 lg:order-none lg:col-start-2 lg:col-span-2 lg:row-start-1 flex flex-col items-center justify-center text-center p-6 md:p-8 border border-border/20 bg-card/30 rounded-xl shadow-sm">
          <p class="text-[#8b5cf6] text-xs tracking-widest mb-3 animate-pulse">ACCESS GRANTED</p>
          <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-foreground mb-5">MERGE CONFLICT</h1>
          <p class="text-sm leading-relaxed break-keep max-w-xl opacity-80 mb-8">
            코모란트에 탑승하신 것을 환영합니다.<br/>
            지각이 있는 인공 존재(ACE)와 강화 인간의 병합 데이터를 기록하고 있습니다.
          </p>

          <div class="flex flex-col sm:flex-row gap-4 w-full max-w-md">
            <a href="/blog" class="flex-1 py-3 bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-[#8b5cf6] hover:bg-[#8b5cf6]/20 hover:border-[#8b5cf6]/60 transition-all rounded text-center text-xs tracking-widest font-bold">
              [ NOVELS ]
            </a>
            <a href="/gallery" class="flex-1 py-3 bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-[#8b5cf6] hover:bg-[#8b5cf6]/20 hover:border-[#8b5cf6]/60 transition-all rounded text-center text-xs tracking-widest font-bold">
              [ GALLERY ]
            </a>
          </div>
        </div>

        <!-- [3] BACKGROUND_TASKS (좌측 하단) -->
        <div class="order-3 lg:order-none lg:col-start-1 lg:row-start-2 flex flex-col p-5 border border-border/20 bg-card/30 rounded-xl shadow-sm">
          <h3 class="text-xs font-bold text-[#8b5cf6] tracking-widest border-b border-[#8b5cf6]/30 pb-2 mb-4">
            [ BACKGROUND_TASKS ]
          </h3>
          <!-- 중간 항목들은 디자인(색상, 투명도)을 완전히 통일했습니다 -->
          <ul class="text-[11px] md:text-xs leading-relaxed space-y-4 opacity-80 flex-grow">
            <li class="line-through opacity-40">[✓] 화물 창고 대기 순환 필터 정화</li>
            <li>[  ] Human_Neva 샤워 모니터링 (예상: 운동 루틴 종료 후, 4시간 뒤)</li>
            <li>[✓] Human_Cathode 온수 사용량 50% 제한 적용 (사유: 에너지 절약)</li>
            <li>[  ] 함선 엔진 냉각수 파이프라인 열화상 스캔 및 위상 보정</li>
            <li>[  ] Human_Neva 수분 손실에 따른 맞춤형 전해질 음료 배합</li>
            <li>[✓] Human_Cathode 생활구역B 출입 권한 박탈 (사유: 오염 및 소음 방지)</li>
            <li class="text-blue-400/90 font-medium">[■] Human_Neva 가슴 근육통 방지를 위한 온열 마사지 모듈 (대기)</li>
          </ul>
        </div>

        <!-- [2] 가이드 및 트리거 워닝 (중앙 하단) -->
        <div class="order-2 lg:order-none lg:col-start-2 lg:row-start-2 flex flex-col p-5 border border-border/20 bg-card/30 rounded-xl shadow-sm">
          <h3 class="text-xs font-bold text-[#8b5cf6] tracking-widest border-b border-[#8b5cf6]/30 pb-2 mb-4">
            [ DIRECTORY_INFO ]
          </h3>
          <div class="space-y-3 text-xs opacity-80 flex-grow">
            <p>> <strong>Novels:</strong> 오리지널 SF GL소설 연재 공간입니다.</p>
            <p>> <strong>Gallery:</strong> 커미션을 포함한 시각 데이터가 올라옵니다.</p>
            <p class="pt-2">> <strong>Notice:</strong> 모든 기록은 비인가 접근으로부터 보호됩니다.</p>
          </div>
          
          <div class="p-4 mt-4 bg-background/50 border border-border/10 rounded">
            <p class="text-[11px] text-muted-foreground opacity-70 leading-relaxed break-keep">
              <strong>TW:</strong> 성적 묘사, 폭력 및 신체 훼손, 범죄, 심리적 압박(가스라이팅, 정보 통제, 합의되지 않은 신체 접촉 및 감각 조작 등), 신체 제어 상실(조종, 익사 및 질식, 신체 개조, 수면 중 관계 등), 다인플, 인외와의 성관계(AI, 외계 생물), 약물 복용 - 각종 이상성욕이 혼재되어 있으니 열람에 주의하세요.
            </p>
          </div>
        </div>

        <!-- [5] 함선 및 보안 시스템 로그 (우측 하단) -->
        <div class="order-5 lg:order-none lg:col-start-3 lg:row-start-2 flex flex-col p-5 border border-border/20 bg-card/30 rounded-xl shadow-sm">
          <h3 class="font-bold text-[#8b5cf6] text-xs tracking-widest border-b border-[#8b5cf6]/30 pb-2 mb-4">
            [ VESSEL_STATUS ]
          </h3>
          <ul class="text-xs space-y-3 opacity-80 flex-grow">
            <!-- 요청하신 퇴역 군함 암시 텍스트로 교체 -->
            <li class="flex justify-between">
              <span class="opacity-50">CLASS:</span> 
              <span class="text-foreground">Corvette <span class="text-xs opacity-60">[RETIRED]</span></span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">VELOCITY:</span> 
              <span><span id="vel-value">0.00</span> km/s</span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">POWER_LOAD:</span> 
              <span><span id="power-value">12.4</span>%</span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">HULL_INTG:</span> 
              <span class="text-[#8b5cf6]"><span id="hull-value">98.2</span>%</span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">O2_RESERVE:</span> 
              <span><span id="o2res-value">84.1</span>%</span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">RAD_LEVEL:</span> 
              <span><span id="rad-value">0.02</span> mSv</span>
            </li>
            <li class="flex justify-between">
              <span class="opacity-50">EXT_TEMP:</span> 
              <span>-270.0 °C</span>
            </li>
          </ul>
          
          <div class="mt-4 pt-4 border-t border-border/10">
            <h4 class="font-bold text-red-500/80 text-xs tracking-widest mb-2">
              [ SECURITY_ALERT ]
            </h4>
            <p class="text-[11px] text-red-500/80 animate-pulse">> UCACEAS_Protocol: OVERRIDDEN</p>
          </div>
        </div>

      </div>
    </div>
  </div>

</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    // 요소 선택
    const els = {
      bpm: document.getElementById('bpm-value'),
      o2: document.getElementById('o2-value'),
      temp: document.getElementById('temp-value'),
      cortisol: document.getElementById('cortisol-value'),
      oxy: document.getElementById('oxy-value'),
      vel: document.getElementById('vel-value'),
      power: document.getElementById('power-value'),
      hull: document.getElementById('hull-value'),
      o2res: document.getElementById('o2res-value'),
      rad: document.getElementById('rad-value'),
    };

    if(els.bpm) {
      setInterval(() => {
        // 생체 데이터 갱신
        els.bpm.innerText = Math.floor(Math.random() * (65 - 55 + 1)) + 55;
        els.o2.innerText = (Math.random() * (48.0 - 45.0) + 45.0).toFixed(1);
        els.temp.innerText = (Math.random() * (37.5 - 37.0) + 37.0).toFixed(1);
        els.cortisol.innerText = (Math.random() * (12.0 - 8.0) + 8.0).toFixed(1);
        els.oxy.innerText = Math.floor(Math.random() * (65 - 40 + 1)) + 40;
        
        // 함선 상태 데이터 갱신 (미세한 변동으로 빈 공간 채우기)
        if(els.vel) {
          els.vel.innerText = (Math.random() * 0.01).toFixed(2);
          els.power.innerText = (Math.random() * (12.5 - 12.0) + 12.0).toFixed(1);
          els.hull.innerText = (Math.random() * (98.3 - 98.1) + 98.1).toFixed(1);
          els.o2res.innerText = (Math.random() * (84.5 - 84.1) + 84.1).toFixed(1);
          els.rad.innerText = (Math.random() * (0.03 - 0.01) + 0.01).toFixed(2);
        }
      }, 2000);
    }
  });
</script>

<style>
  .ecg-animate {
    animation: ecgSlide 1.5s linear infinite;
  }
  @keyframes ecgSlide {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }
</style>
